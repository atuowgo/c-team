{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@common/*": ["./src/common/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/common/**/*"
  ]
}